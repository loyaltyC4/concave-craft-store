# Fingerboard Lab runs on a bundled static catalog — no Shopify credentials
# are required. Set these to enable the corresponding live feature; the site
# builds and runs safely with any/all of them unset (features degrade
# gracefully instead of erroring).

# Canonical site URL used for metadata, sitemap, and OG images.
NEXT_PUBLIC_SITE_URL="https://fingerboardlab.com"

# Stripe — enables real checkout (card payments). Without this, checkout
# returns a clear "not live yet" message instead of erroring.
STRIPE_SECRET_KEY=""

# Stripe webhook secret — required for orders to be recorded, inventory to be
# decremented, and confirmation emails to be sent. Get this by adding a
# webhook endpoint in the Stripe Dashboard (Developers -> Webhooks) pointing
# to https://<your-domain>/api/webhooks/stripe, subscribed to the
# checkout.session.completed event. Without this set, the webhook route
# returns a clear "not configured" response instead of erroring.
STRIPE_WEBHOOK_SECRET=""

# Supabase — enables email signups (/api/subscribe), product review
# submissions (/api/reviews POST), and the order/inventory system (Stripe
# webhook + /admin/orders). Without these, everything degrades gracefully:
# subscribe returns "not open yet", reviews show real data only when present,
# and orders simply aren't recorded — nothing is ever fabricated.
# Use the SERVICE ROLE key (server-only; never expose it to the browser).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Admin order view (/admin/orders) — pick any password yourself; this is not
# a third-party account. Without it, the admin area shows a setup notice.
ADMIN_ACCESS_KEY=""

# Optional — enables a branded HTML order-confirmation email (with a bcc to
# ADMIN_NOTIFICATION_EMAIL) via Resend. Without this, orders are still
# recorded and viewable in /admin/orders; only the branded email is skipped.
# Immediate zero-cost alternative: turn on Stripe's own "Successful payments"
# receipt email in Dashboard -> Settings -> Customer emails.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Fingerboard Lab <onboarding@resend.dev>"
ADMIN_NOTIFICATION_EMAIL=""

# ── SEO ───────────────────────────────────────────────────────────────────────
# Canonical origin. Set this to the custom domain the moment it is live in
# Vercel — every canonical, OG URL, sitemap entry and JSON-LD id derives from it,
# so this one variable moves the whole site to the new domain.
# NEXT_PUBLIC_SITE_URL="https://fingerboardlab.com"

# Search Console / Bing Webmaster meta-tag verification (optional; DNS TXT works too)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="..."
# NEXT_PUBLIC_BING_SITE_VERIFICATION="..."

# ── Analytics ─────────────────────────────────────────────────────────────────
# Google Analytics 4 measurement ID. Set in Vercel (production only, so local
# dev / preview deploys don't pollute real GA4 data) to enable the gtag.js
# base tag plus ecommerce events (view_item, add_to_cart, begin_checkout,
# purchase) — see lib/gtag.ts for the event helpers and their call sites.
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
