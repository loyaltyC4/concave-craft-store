# ── Store branding ───────────────────────────────────────────────
SITE_NAME="Fingerboard Lab"
COMPANY_NAME="Fingerboard Lab"

# Public site URL — used for SEO canonical URLs, sitemap, and Stripe redirects.
# In production, set this to your custom domain.
NEXT_PUBLIC_SITE_URL="https://fingerboardlab.com"

# ── Stripe (payments) ────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
# Use TEST keys (sk_test_...) until you're ready to go live.
STRIPE_SECRET_KEY="sk_test_xxx"

# Optional: from your Stripe webhook endpoint (Developers → Webhooks).
# Enables order events at /api/stripe/webhook. Safe to leave blank for launch.
STRIPE_WEBHOOK_SECRET="whsec_xxx"
